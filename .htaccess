# Блокуємо прямий доступ до файлів із секретами та лідами
<FilesMatch "^(config\.php|leads\.csv)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 301: /index.html -> /, /ru/index.html -> /ru/ (THE_REQUEST, щоб не зациклитись із DirectoryIndex)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{THE_REQUEST} \s/(.*/)?index\.html[\s?] [NC]
    RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]
</IfModule>
